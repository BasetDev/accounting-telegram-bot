# ==============================
# Debt & Receivable Lists
# ==============================

@router.message(F.text == "📋 لیست بدهی‌ها")
async def debt_list(message: Message):
    """Show list of debts."""
    session = get_session()
    try:
        user = get_user(session, message)
        debts = TransactionRepository.get_by_user(session, user.id, transaction_type="debt", limit=50)
        
        if not debts:
            await message.answer("📭 هیچ بدهی ثبت نشده است.")
            return
        
        text = "📋 لیست بدهی‌ها:\n\n"
        total = 0
        for i, txn in enumerate(debts, 1):
            total += txn.amount
            settled = "✅" if txn.is_settled else "⏳"
            text += f"{i}. {settled} {format_amount(txn.amount)} تومان\n"
            if txn.party_name:
                text += f"   👤 {txn.party_name}\n"
            if txn.description:
                text += f"   📝 {txn.description}\n"
            if txn.due_jalali_date:
                days_left = get_days_until(txn.due_jalali_date)
                if txn.is_settled:
                    text += f"   📅 سررسید: {txn.due_jalali_date}\n"
                elif days_left < 0:
                    text += f"   🔴 سررسید: {txn.due_jalali_date} (منقضی)\n"
                elif days_left == 0:
                    text += f"   🟡 سررسید: {txn.due_jalali_date} (امروز)\n"
                else:
                    text += f"   🟢 سررسید: {txn.due_jalali_date} ({days_left} روز مانده)\n"
            text += f"   📅 ثبت: {txn.jalali_date}\n\n"
        
        text += f"——————————\n📊 مجموع: {format_amount(total)} تومان"
        await message.answer(text)
    except Exception as e:
        logger.error(f"Error listing debts: {e}")
        await message.answer(ERROR_GENERAL)
    finally:
        session.close()


@router.message(F.text == "📌 لیست طلب‌ها")
async def receivable_list(message: Message):
    """Show list of receivables."""
    session = get_session()
    try:
        user = get_user(session, message)
        receivables = TransactionRepository.get_by_user(session, user.id, transaction_type="receivable", limit=50)
        
        if not receivables:
            await message.answer("📭 هیچ طلبی ثبت نشده است.")
            return
        
        text = "📌 لیست طلب‌ها:\n\n"
        total = 0
        for i, txn in enumerate(receivables, 1):
            total += txn.amount
            settled = "✅" if txn.is_settled else "⏳"
            text += f"{i}. {settled} {format_amount(txn.amount)} تومان\n"
            if txn.party_name:
                text += f"   👤 {txn.party_name}\n"
            if txn.description:
                text += f"   📝 {txn.description}\n"
            if txn.due_jalali_date:
                days_left = get_days_until(txn.due_jalali_date)
                if txn.is_settled:
                    text += f"   📅 سررسید: {txn.due_jalali_date}\n"
                elif days_left < 0:
                    text += f"   🔴 سررسید: {txn.due_jalali_date} (منقضی)\n"
                elif days_left == 0:
                    text += f"   🟡 سررسید: {txn.due_jalali_date} (امروز)\n"
                else:
                    text += f"   🟢 سررسید: {txn.due_jalali_date} ({days_left} روز مانده)\n"
            text += f"   📅 ثبت: {txn.jalali_date}\n\n"
        
        text += f"——————————\n📊 مجموع: {format_amount(total)} تومان"
        await message.answer(text)
    except Exception as e:
        logger.error(f"Error listing receivables: {e}")
        await message.answer(ERROR_GENERAL)
    finally:
        session.close()


